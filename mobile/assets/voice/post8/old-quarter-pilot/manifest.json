        {
          "id": "oldquarter-bach-ma-caption",
          "contentId": "oldquarter-bach-ma-caption",
          "kind": "caption",
          "nodeId": "oldquarter-bach-ma",
          "locale": "vi",
          "collectionId": "old-quarter-pilot",
          "datasetRevision": "358209bc5bf8f14e47a3598b93644d168219d919dcb66d9eb1f7cbb7dbd2c94a",
          "source": "data/localized/old-quarter.vi.json",
          "sourceDataSha256": "58791331dc736764f71f73f5e656f2cc7c20f300b3e21656f7ac7077943eea93",
          "sourceTextSha256": "d8e61b8540069307dae429fc25bd795a10935dcf621a3cf5f5a9f868027840e4",
          "textHash": "d8e61b8540069307dae429fc25bd795a10935dcf621a3cf5f5a9f868027840e4",
          "spokenText": "Bạch Mã: thờ Long Đỗ, Trấn Đông; chuyện ngựa trắng được ghi là truyền thuyết.",
          "spokenTextSha256": "d8e61b8540069307dae429fc25bd795a10935dcf621a3cf5f5a9f868027840e4",
          "path": "mobile/assets/voice/post8/old-quarter-pilot/vi/oldquarter-bach-ma-caption.mp3",
