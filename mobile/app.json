{
  "expo": {
    "name": "Ngõ Kể",
    "slug": "ngo-ke-demo",
    "version": "0.1.0",
    "platforms": [
      "android",
      "ios"
    ],
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Cho phép Ngõ Kể dùng camera để quét mã QR của điểm.",
        "NSLocationWhenInUseUsageDescription": "Cho phép Ngõ Kể đọc vị trí một lần để gợi ý điểm gần nhất. App không theo dõi vị trí nền."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Ngõ Kể dùng camera để quét mã QR của điểm."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép Ngõ Kể đọc vị trí một lần để gợi ý điểm gần nhất. App không theo dõi vị trí nền."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": ""
    }
  }
}
