{
  "expo": {
    "name": "Ngõ Kể",
    "slug": "ngo-ke-demo",
    "version": "0.1.0",
    "platforms": [
      "android",
      "ios"
    ],
    "orientation": "default",
    "icon": "./assets/icon.expo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "runtimeVersion": "exposdk:57.0.0",
      "infoPlist": {
        "NSCameraUsageDescription": "Cho phép Ngõ Kể dùng camera để quét mã QR của điểm.",
        "NSLocationWhenInUseUsageDescription": "Cho phép Ngõ Kể đọc vị trí một lần để gợi ý điểm gần nhất. App không theo dõi vị trí nền."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "predictiveBackGestureEnabled": true,
      "package": "com.valentino241.ngokedemo"
    },
    "plugins": [
      "./plugins/withVoiceGatewayNetworkSecurity.cjs",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.expo.png",
          "resizeMode": "contain",
          "backgroundColor": "#1E6B4A"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Ngõ Kể dùng camera để quét mã QR của điểm."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép Ngõ Kể đọc vị trí một lần để gợi ý điểm gần nhất. App không theo dõi vị trí nền."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Cho phép Ngõ Kể thu giọng nói để nhận câu hỏi của bạn.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "apiBaseUrl": "",
      "voiceApiBaseUrl": "",
      "eas": {
        "projectId": "53f37ee9-2fea-4300-a792-27aa74b994a2"
      }
    },
    "owner": "valentino241",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/53f37ee9-2fea-4300-a792-27aa74b994a2"
    }
  }
}
